pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        DOCKER_IMAGE = 'hoaitay/devops-lab8-app'
        CONTAINER_NAME = 'lab8-cd-production'
        DOCKER_CONFIG = "${WORKSPACE}/.docker-auth"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build \
                      -t "$DOCKER_IMAGE:cd-$BUILD_NUMBER" \
                      -t "$DOCKER_IMAGE:latest" .
                '''
            }
        }

        stage('Docker Scan') {
            steps {
                sh '''
                    if docker scout version >/dev/null 2>&1; then
                        docker scout quickview "$DOCKER_IMAGE:cd-$BUILD_NUMBER"
                    else
                        echo "SKIPPED: Docker Scout is not installed."
                    fi
                '''
            }
        }

        stage('Push to Registry') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-hub-credentials_1',
                        usernameVariable: 'HUB_USER',
                        passwordVariable: 'HUB_PASS'
                    )
                ]) {
                    sh '''
                        set +x
                        mkdir -p "$DOCKER_CONFIG"
                        printf '%s' "$HUB_PASS" |
                          docker login -u "$HUB_USER" --password-stdin
                        docker push "$DOCKER_IMAGE:cd-$BUILD_NUMBER"
                        docker push "$DOCKER_IMAGE:latest"
                    '''
                }
            }
        }

        stage('Deploy Container') {
            steps {
                sh '''
                    docker pull "$DOCKER_IMAGE:cd-$BUILD_NUMBER"

                    if docker container inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
                        docker rm -f "$CONTAINER_NAME"
                    fi

                    docker run -d \
                      --name "$CONTAINER_NAME" \
                      -p 3002:3000 \
                      --restart unless-stopped \
                      "$DOCKER_IMAGE:cd-$BUILD_NUMBER"
                '''
            }
        }

        stage('Verify Deploy') {
            steps {
                sh '''
                    ready=false

                    for attempt in $(seq 1 30); do
                        if docker exec "$CONTAINER_NAME" \
                          wget -q -O - http://127.0.0.1:3000/health; then
                            ready=true
                            break
                        fi
                        sleep 2
                    done

                    if [ "$ready" != "true" ]; then
                        docker logs "$CONTAINER_NAME"
                        exit 1
                    fi

                    docker exec "$CONTAINER_NAME" \
                      wget -q -O - http://127.0.0.1:3000/
                '''
            }
        }
    }

    post {
        always {
            sh 'rm -rf "$DOCKER_CONFIG"'
        }
        success {
            echo 'CD SUCCESS - Open http://localhost:3002'
        }
        failure {
            echo 'CD FAILED - Check Console Output'
        }
    }
}